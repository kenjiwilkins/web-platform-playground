---
import '../styles/global.css';
import { categoryLabels } from '../lib/data';

interface Props {
  title: string;
  description?: string;
  /** 正規 URL（バリアントページは親に向ける） */
  canonical?: string;
  noindex?: boolean;
  /** 埋め込み用: ヘッダとフッタを出さない */
  bare?: boolean;
  current?: string;
}

const { title, description, canonical, noindex = false, bare = false, current } = Astro.props;
const fullTitle =
  title === 'Web Platform Playground' ? title : `${title} | Web Platform Playground`;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ja" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+JP:wght@400;600;700&family=JetBrains+Mono:wght@400;600&display=swap"
    />
    <script is:inline>
      try {
        const saved = localStorage.getItem('wpp-theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {
        // ストレージが使えない環境では既定のダークテーマのまま
      }
    </script>
    <slot name="head" />
  </head>
  <body>
    {!bare && (
      <header class="site-header">
        <div class="container header-inner">
          <a class="wordmark" href="/">
            Web Platform <span>Playground</span>
          </a>
          <nav aria-label="カテゴリ">
            {Object.entries(categoryLabels).map(([key, label]) => (
              <a href={`/${key}/`} aria-current={current === key ? 'page' : undefined}>
                {label}
              </a>
            ))}
          </nav>
          <div class="header-actions">
            <button class="wp-btn" type="button" id="theme-toggle" aria-label="テーマを切り替え">
              ◐
            </button>
            <a class="wp-btn wp-btn-primary" href="/scratch/">
              Scratch
            </a>
          </div>
        </div>
      </header>
    )}
    <main>
      <slot />
    </main>
    {!bare && (
      <footer class="site-footer container muted">
        Web Platform Playground — 互換データ: MDN browser-compat-data / web-features
      </footer>
    )}
    <script>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('wpp-theme', next);
        } catch {
          // 保存できなくてもこのページ内では切り替わる
        }
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    border-bottom: var(--bw-1) solid var(--border);
    background: var(--surface);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    height: 56px;
  }
  .wordmark {
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
  }
  .wordmark span {
    color: var(--accent);
  }
  nav {
    display: flex;
    gap: var(--space-4);
  }
  nav a {
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 600;
  }
  nav a[aria-current='page'],
  nav a:hover {
    color: var(--text);
  }
  .header-actions {
    margin-left: auto;
    display: flex;
    gap: var(--space-2);
  }
  .site-footer {
    padding-block: var(--space-7);
    font-size: var(--caption-size);
  }
  @media (max-width: 720px) {
    nav {
      display: none;
    }
  }
</style>
